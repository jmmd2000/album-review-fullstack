{
  "name": "@album-reviews/api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --legacy-watch --exec tsx src/index.ts",
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "db:reset": "tsx ./src/db/migrate.ts && tsx ./src/db/wipe.ts && tsx ./src/db/seed.ts",
    "db:studio": "drizzle-kit studio --verbose",
    "db:seed": "tsx ./src/db/seed.ts",
    "db:wipe": "tsx ./src/db/wipe.ts",
    "db:capture-fixtures": "tsx ./src/db/fixtures/capture.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@album-reviews/shared": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "express-rate-limit": "8.7.1",
    "extract-colors": "4.2.1",
    "get-pixels": "3.3.3",
    "hono": "4.13.13",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "puppeteer-core": "24.37.3",
    "slugify": "1.6.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/get-pixels": "3.3.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "nodemon": "3.1.14",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
