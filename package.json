{
  "version": "1.39.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "26.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check . && eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run --project shared --project web --project api-unit",
    "test:integration": "vitest run --project api-integration",
    "test:e2e": "pnpm --filter @album-reviews/web test:e2e",
    "coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
