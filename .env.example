# One .env at the repo root serves the API, the web app, e2e and docker compose.

# -----------
# PostgreSQL
# -----------
POSTGRES_USER= # Postgres username
POSTGRES_PASSWORD= # Postgres password
POSTGRES_DB= # Postgres database name, albums_dev locally
DATABASE_URL= # Database URL string for local dev, pointing at albums_dev
DATABASE_URL_TEST= # The unit test database, albums_test
DATABASE_URL_TEST_E2E= # The e2e database, albums_test_e2e

# ----
# API
# ----
CLIENT_ORIGIN= # Comma-separated https origins allowed by CORS in production and staging
SCHEDULED_REFRESH= # "true" only in production, where the api refreshes artist photos and headers by itself (off when unset)
# PORT= # The port the api listens on (4000 when unset). Compose and e2e set it, so leave it out of .env.

# ----
# Web
# ----
# API_ORIGIN= # Where the web server reaches the api for server rendering (http://localhost:4000 in dev when unset). Compose and e2e set it.

# ------------
# Spotify API
# ------------
SPOTIFY_CLIENT_ID= # Your Spotify API client ID
SPOTIFY_CLIENT_SECRET= # Your Spotify API client secret

# ---------------
# Authentication
# ---------------
ADMIN_PASSWORD= # Plaintext admin password for local dev and e2e only (production uses ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD_HASH= # A bcrypt hash of your desired admin password
JWT_SECRET= # A random string of at least 32 characters, used to sign JWTs

# ------------
# Browserless
# ------------
BROWSERLESS_TOKEN= # Shared secret between the api and the browserless sidecar (dev falls back to dev-token)
BROWSERLESS_URL= # Websocket endpoint of the sidecar (defaults to ws://localhost:3000 for bare local dev; in docker it is ws://browserless:3000)

# ---------------------------------------------------
# Production compose (Jenkins writes these on deploy)
# ---------------------------------------------------
# APP_NAME= # The compose project, such as album-reviews-production. backup.sh uses it too.
# DOMAIN= # The site's domain, for the traefik routes
# GITHUB_USER= # The GHCR account the images come from
# IMAGE_TAG= # The short commit SHA of the images to run

# --------------------------------------------------
# Build info (Jenkins passes these as image build args)
# --------------------------------------------------
# GIT_SHA= # The commit the image was built from
# GIT_MESSAGE_B64= # The commit message, base64 encoded
# BUILT_AT= # When the image was built
