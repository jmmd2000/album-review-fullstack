# -----------
# PostgreSQL
# -----------
POSTGRES_USER= # Postgres username
POSTGRES_PASSWORD= # Postgres password
POSTGRES_DB= # Postgres database name, albums_dev locally
DATABASE_URL= # Database URL string for local dev, pointing at albums_dev
DATABASE_URL_TEST= # The unit test database, albums_test
DATABASE_URL_TEST_E2E= # The e2e database, albums_test_e2e
DATABASE_URL_PROD= # Database URL string for production

# ---------
# App URLs
# ---------
VITE_API_URL= # Base URL for API requests in development
CLIENT_ORIGIN= # Base URL for frontend (for CORS)

# ------------
# Spotify API
# ------------
SPOTIFY_CLIENT_ID= # Your Spotify API client ID
SPOTIFY_CLIENT_SECRET= # Your Spotify API client secret
SPOTIFY_REFRESH_TOKEN= # A Spotify API refresh token

# ---------------
# Authentication
# ---------------
ADMIN_PASSWORD= # Plaintext admin password for local dev/tests only (production uses ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD_HASH= # A bcrypt hash of your desired admin password
JWT_SECRET= # A random string used to sign JWTs

# ------------
# Browserless
# ------------
BROWSERLESS_TOKEN= # Shared secret between the api and the browserless sidecar (dev falls back to dev-token)
BROWSERLESS_URL= # Websocket endpoint of the sidecar (defaults to ws://localhost:3000 for bare local dev; in docker it is ws://browserless:3000)

# ------------------
# Scheduled refresh
# ------------------
SCHEDULED_REFRESH= # "true" only in production, where the api refreshes artist photos and headers by itself (off when unset)
